{% extends 'mainvista/base.html' %}

{% block content %}
<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">📋 Panel de Control de Inventario Retail</h1>
            <p class="text-sm text-gray-500 mt-1">Monitoreo de existencias en tiempo real optimizado para computadoras de escritorio.</p>
        </div>
        <button class="mt-4 md:mt-0 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm py-2 px-4 rounded shadow transition">
            ➕ Registrar Nuevo Producto
        </button>
    </div>

    <!-- Sección de Alertas Críticas Dinámicas -->
    {% if alertas %}
    <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-r-md">
        <div class="flex">
            <span class="text-red-500 mr-3">⚠️</span>
            <div>
                <h3 class="text-sm font-semibold text-red-800">ATENCIÓN: Productos en Niveles Críticos</h3>
                <p class="text-xs text-red-700 mt-1">Los siguientes artículos han alcanzado o superado el stock mínimo permitido y requieren reabastecimiento inmediato:</p>
                <ul class="list-disc list-inside text-xs text-red-700 mt-2 font-medium">
                    {% for alerta in alertas %}
                        <li>{{ alerta.nombre }} (SKU: {{ alerta.sku }}) - Solo quedan {{ alerta.stock_actual }} piezas.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Tabla de Datos del Inventario -->
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left font-semibold text-gray-600 tracking-wider">Código SKU</th>
                    <th class="px-6 py-3 text-left font-semibold text-gray-600 tracking-wider">Descripción del Producto</th>
                    <th class="px-6 py-3 text-left font-semibold text-gray-600 tracking-wider">Categoría</th>
                    <th class="px-6 py-3 text-left font-semibold text-gray-600 tracking-wider">Precio Unitario</th>
                    <th class="px-6 py-3 text-left font-semibold text-gray-600 tracking-wider">Existencias</th>
                    <th class="px-6 py-3 text-left font-semibold text-gray-600 tracking-wider">Estado Almacén</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% if productos %}
                    {% for producto in productos %}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 whitespace-nowrap font-mono font-bold text-blue-700">{{ producto.sku }}</td>
                        <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900">{{ producto.nombre }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-gray-500">{{ producto.categoria.nombre }}</td>
                        <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-700">${{{ producto.precio }}}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-gray-900 font-semibold">{{ producto.stock_actual }} pzas</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            {% if producto.stock_actual <= producto.stock_minimo %}
                                <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800 animate-pulse">
                                    🔴 Crítico (Reabastecer)
                                </span>
                            {% else %}
                                <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                    🟢 Stock Óptimo
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-10 text-center text-gray-400">
                            No hay productos registrados en el inventario actualmente.
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
